# Guanzhi 官制 - 朝堂 window (generated by _build/make_gui.py, do not edit by hand)
# Parasitic on the vanilla court window; lists every court office with its holder,
# grouped by 文官/武官 and rank group. Only groups with at least one holder are shown.

window = {
	name = "guanzhi_chaotang_window"
	datacontext = "[GetPlayer]"

	visible = "[And( IsGameViewOpen('court_window'), And( Not( GetVariableSystem.Exists( 'guanzhi_chaotang_hidden' ) ), And( GetPlayer.GetPrimaryTitle.IsValid, And( GreaterThanOrEqualTo_int32(GetPlayer.GetPrimaryTitle.GetTierFrame, '(int32)6'), GetPlayer.GetGovernment.IsType( 'celestial_government' ) ) ) ) )]"

	parentanchor = top|left
	position = { 20 60 }
	size = { 980 900 }
	minimumsize = { 600 300 }
	layer = windows_layer
	movable = yes

	using = Window_Background
	using = Window_Decoration

	state = {
		name = _show
		using = Animation_FadeIn_Standard
		on_start = "[GetVariableSystem.Set( 'guanzhi_chaotang_tab', 'civil' )]"
	}
	state = {
		name = _hide
		using = Animation_FadeOut_Standard
	}

	vbox = {
		using = Window_Margins

		header_pattern = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text"
			{
				text = "guanzhi_chaotang_window_name"
			}

			blockoverride "button_close"
			{
				onclick = "[GetVariableSystem.Toggle( 'guanzhi_chaotang_hidden' )]"
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			size = { 0 60 }
			spacing = 5
			margin = { 10 0 }

						button_tab = {
							size = { 200 50 }
							down = "[GetVariableSystem.HasValue( 'guanzhi_chaotang_tab', 'civil' )]"
							onclick = "[GetVariableSystem.Set( 'guanzhi_chaotang_tab', 'civil' )]"
							background = {
								texture = "gfx/interface/icons/banners/banner_red_background_tgp.dds"
								alpha = 0.8
							}
							text_single = {
								parentanchor = center
								text = "guanzhi_chaotang_tab_civil"
								default_format = "#color:{1.0 1.0 1.0 1.0}"
							}
						}

						button_tab = {
							size = { 200 50 }
							down = "[GetVariableSystem.HasValue( 'guanzhi_chaotang_tab', 'military' )]"
							onclick = "[GetVariableSystem.Set( 'guanzhi_chaotang_tab', 'military' )]"
							background = {
								texture = "gfx/interface/icons/banners/banner_red_background_tgp.dds"
								alpha = 0.8
							}
							text_single = {
								parentanchor = center
								text = "guanzhi_chaotang_tab_military"
								default_format = "#color:{1.0 1.0 1.0 1.0}"
							}
						}
		}

		vbox = {
			layoutpolicy_vertical = expanding

			# ----- Page: civil -----
			widget = {
				size = { 940 770 }
				visible = "[Or( GetVariableSystem.HasValue( 'guanzhi_chaotang_tab', 'civil' ), Not( GetVariableSystem.Exists( 'guanzhi_chaotang_tab' ) ) )]"

				scrollbox = {
					size = { 100% 100% }
					blockoverride "scrollbox_content"
					{
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 16
							margin = { 8 8 }

							text_single = {
								text = "guanzhi_chaotang_hint"
								using = Font_Size_Small
								default_format = "#weak"
							}

						# ---- 三师三公 ----
						widget = {
							visible = "[GetScriptedGui( 'guanzhi_uses_tang_sgui' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							layoutpolicy_horizontal = expanding

							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4

								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 10 2 }
									spacing = 10

									divider_light = {
										layoutpolicy_horizontal = expanding
									}
									text_single = {
										text = "guanzhi.sg.T.sanshi"
										using = Font_Size_Medium
										default_format = "#high"
										align = nobaseline
									}
									divider_light = {
										layoutpolicy_horizontal = expanding
									}
								}

								flowcontainer = {
									direction = horizontal
									spacing = 4

					button = { # 太师
						datacontext = "[GetTitleByKey('e_gz_t_taishi')]"
						visible = "[GetTitleByKey('e_gz_t_taishi').GetHolder.IsValid]"
						enabled = "[And( Title.GetHolder.IsValid, Not( ObjectsEqual( Title.GetHolder.Self, GetPlayer.Self ) ) )]"
						onclick = "[ToggleFilteredCharacterInteractionMenu( Title.GetHolder.Self, 'guanzhi' )]"
						tooltip = "gz_office.t_taishi"
						size = { 96 132 }
						layoutpolicy_vertical = fixed

						vbox = {
							spacing = 2
							margin = { 2 4 }
							margin_left = 10

							icon = {
								texture = "gfx/interface/icons/guanzhi/gz_t_taishi.dds"
								size = { 42 42 }
							}
							text_single = {
								text = "gz_office.t_taishi"
							}
							text_single = {
								text = "[Title.GetHolder.GetShortUINameNoTooltip]"
								visible = "[And( Title.GetHolder.IsValid, Not( ObjectsEqual( Title.GetHolder.Self, GetPlayer.Self ) ) )]"
							}
							text_single = {
								text = "guanzhi_vacant"
								visible = "[Or( Not( Title.GetHolder.IsValid ), ObjectsEqual( Title.GetHolder.Self, GetPlayer.Self ) )]"
							}
							button = {
								visible = "[And( Title.GetHolder.IsValid, Not( ObjectsEqual( Title.GetHolder.Self, GetPlayer.Self ) ) )]"
								onclick = "[GetScriptedGui('guanzhi_replace_officer_sgui').Execute( GuiScope.SetRoot( Title.GetHolder.MakeScope ).End )]"
								tooltip = "guanzhi_replace_tt"
								size = { 56 22 }
								layoutpolicy_vertical = fixed

								text_single = {
									text = "guanzhi_replace"
									parentanchor = center
								}
							}
						}
					}
					button = { # 太师
						datacontext = "[GetTitleByKey('k_gz_t_taishi')]"
						visible = "[Or( GetTitleByKey('k_gz_t_taishi').GetHolder.IsValid, Not( GetTitleByKey('e_gz_t_taishi').GetHolder.IsValid ) )]"
