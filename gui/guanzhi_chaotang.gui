# Small show-button window, visible after the main window was hidden with the X button
window = {
	name = "guanzhi_chaotang_window_toggler"
	datacontext = "[GetPlayer]"

	visible = "[And( IsGameViewOpen('court_window'), And( GetVariableSystem.Exists( 'guanzhi_chaotang_hidden' ), And( GetPlayer.GetPrimaryTitle.IsValid, And( GreaterThanOrEqualTo_int32(GetPlayer.GetPrimaryTitle.GetTierFrame, '(int32)6'), GetPlayer.GetGovernment.IsType( 'celestial_government' ) ) ) ) )]"

	parentanchor = top|left
	position = { 20 10 }
	size = { 60 60 }
	layer = windows_layer
	movable = yes

	button = {
		size = { 60 60 }
		onclick = "[GetVariableSystem.Toggle( 'guanzhi_chaotang_hidden' )]"
		tooltip = "guanzhi_chaotang_window_name"
		background = {
			texture = "gfx/interface/icons/banners/banner_red_background_tgp.dds"
		}
		text_single = {
			text = "guanzhi_chaotang_window_name"
			default_format = "#color:{1.0 1.0 1.0 1.0}"
			margin = { 6 20 }
		}
	}
}
